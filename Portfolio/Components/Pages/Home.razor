  private record ProfileItem(string Label, string Value);
  private record ImpactStat(string Label, string Value, string Description);
  private record SkillGroup(string Title, string[] Skills);
  private record FeaturedProject(string Title, string Stack, string Description, string Status, string[] Tags);

  //js animation
  private bool _revealInitialized;
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender && !_revealInitialized)
    {
      _revealInitialized = true;
      await JS.InvokeVoidAsync("initRevealSections");
    }
  }
}

@code {
  private bool _previewOpen;
  private bool _pinned;
  private PetPreviewData? _currentPet;
  private string _popoverStyle = "top: 0px; left: 0px;";
  private class DomRect
  {
    public double width { get; set; }
    public double height { get; set; }
  }
  private class PopoverPos
  {
    public double left { get; set; }
    public double top { get; set; }
  }
  private async Task OnPetMouseMove(MouseEventArgs e)
  {
    //measure the popover if already rendered, otherwise default values
    double modalWith = 350, modalHeight = 300;
    if (_previewOpen)
    {
      var rect = await JS.InvokeAsync<DomRect>("eval",
$"document.querySelector('.pet-preview-popover')?.getBoundingClientRect()");
      if (rect != null)
      {
        modalWith = rect.width;
        modalHeight = rect.height;
      }
    }
    var pos = await JS.InvokeAsync<PopoverPos>("calculatePopoverPosition", e.ClientX, e.ClientY, modalWith, modalHeight);
    _popoverStyle = $"top: {pos.top}px; left: {pos.left}px;";
  }

  private void HidePetPreview()
  {
    if (!_pinned)
    {
      _previewOpen = false;
      _currentPet = null;
    }
  }

  private void ShowPetPreview(string name)
  {
    if (_pinned) return;
    _currentPet = PetPreviewData.Pets.FirstOrDefault(d => d.Name == name);
    _previewOpen = _currentPet is not null;
  }

  private void PinPetPreview(string name)
  {
    _currentPet = PetPreviewData.Pets.FirstOrDefault(d => d.Name == name);
    _previewOpen = _currentPet is not null;
    _pinned = true;
  }

  private Task ClosePreview()
  {
    _previewOpen = false;
    _pinned = false;
    return Task.CompletedTask;
  }
}