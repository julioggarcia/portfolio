@page "/"

@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Julio Garcia</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100">
  <!-- Top nav -->
  <div class="flex pt-6">
    <div class="flex justify-start ml-auto text-sm px-2">
      <ol class="flex flex-wrap gap-3 text-sm font-medium uppercase tracking-[0.3em] text-cyan-400">
        <li><a href="#about" class="transition hover:text-cyan-300">About</a></li>
        <li><a href="#projects" class="transition hover:text-cyan-300">Projects</a></li>
        <li><a href="#resume" class="transition hover:text-cyan-300">Resume</a></li>
      </ol>
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-6 py-10 lg:px-8">
    <!-- Hero -->
    <section class="min-h-screen p-8 flex items-center">
      <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr] lg:items-center w-full">
        <div>
          <p class="text-sm font-medium tracking-[0.3em] text-cyan-400">
            Hi, my name is
          </p>

          <h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-5xl outline-none focus:outline-none">
            Julio Gonzalez Garcia
          </h1>

          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">
            I build reliable web applications, automation tools, and data-driven systems
            with a focus on clarity, maintainability, and practical impact.
          </p>

          <p class="mt-4 max-w-2xl text-slate-400">
            My background includes full-stack development, SQL Server and Oracle environments,
            system analysis, and workflow automation across business-critical applications.
          </p>
        </div>
      </div>
    </section>

    <section id="about" class="reveal-section reveal-delay-2 scroll-mt-8 p-1">
      <About OnPetPreview="@ShowPetPreview" OnPetPreviewMove="@OnPetMouseMove" OnPetPreviewHide="@HidePetPreview" />
    </section>

    <!-- Skills -->
    <section id="skills" class="reveal-section reveal-delay-1 mt-2 p-1">
      <SkillsMarquee Skills="@SkillList" />
    </section>

    <section id="history" class="reveal-section reveal-delay-6 p-1">
      <Timeline />
    </section>

    <section id="projects" class="reveal-section reveal-delay-4 mt-10">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-sm font-medium uppercase tracking-[0.3em] text-cyan-400">Projects </p>
          <p class="mt-2 text-slate-400">A few projects that reflect the kind of work I enjoy building.</p>
        </div>
      </div>

      <div class="mt-6 grid gap-4 lg:grid-cols-2">
        @foreach (FeaturedProject project in FeaturedProjects)
        {
          <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-xl font-semibold text-white">@project.Title</h3>
                <p class="mt-2 text-sm text-cyan-400">@project.Stack</p>
              </div>
              <span class="rounded-full bg-slate-800 px-3 py-1 text-xs font-medium text-slate-300">
                @project.Status
              </span>
            </div>

            <p class="mt-4 leading-7 text-slate-300">@project.Description</p>

            <div class="mt-5 flex flex-wrap gap-2">
              @foreach (var tag in project.Tags)
              {
                <span class="rounded-full border border-slate-700 bg-slate-950 px-3 py-1 text-xs text-slate-400">
                  @tag
                </span>
              }
            </div>
          </article>
        }
      </div>
    </section>

    <section id="resume"
             class="reveal-section reveal-delay-5 mt-10 scroll-mt-8">
      <!-- Resume content -->
      <Resume></Resume>
    </section>

  </div>
</div>

<div class="fixed bottom-0 left-8 z-50 hidden md:flex flex-col items-center">
  <ul class="flex flex-col items-center gap-5 text-slate-400">
    <li>
      <a href="https://github.com/julioggarcia" aria-label="GitHub" target="_blank" rel="noreferrer"
         class="transition hover:-translate-y-1 hover:text-cyan-400">
        <svg xmlns="http://www.w3.org/2000/svg" role="img" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
          <title>GitHub</title>
          <path
            d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22">
          </path>
        </svg>
      </a>
    </li>

    <li>
      <a href="https://www.linkedin.com/in/julio-ggarcia" aria-label="LinkedIn" target="_blank" rel="noreferrer"
         class="transition hover:-translate-y-1 hover:text-cyan-400">
        <svg xmlns="http://www.w3.org/2000/svg" role="img" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
          <title>LinkedIn</title>
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect x="2" y="9" width="4" height="12"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </a>
    </li>
  </ul>

  <div class="mt-6 h-24 w-px bg-slate-600"></div>
</div>

<PetPreviewPopover IsOpen="@_previewOpen" CurrentPet="@_currentPet" PopoverStyle="@_popoverStyle"
                   OnClose="ClosePreview" />

